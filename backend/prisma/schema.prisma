datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id          String     @id @default(uuid())
  name        String
  code        String     @unique
  logoUrl     String?
  website     String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       User[]
  departments Department[]
  employees   Employee[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String
  role           String        @default("EMPLOYEE") // SUPER_ADMIN, HR_ADMIN, HR_MANAGER, MANAGER, EMPLOYEE, RECRUITER
  isActive       Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  employee       Employee?
  notifications  Notification[]
  auditLogs      AuditLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([email])
  @@index([role])
}

model Department {
  id             String        @id @default(uuid())
  name           String
  code           String        @unique
  description    String?
  budget         Float         @default(0)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  managerId      String?
  manager        Employee?     @relation("DeptManager", fields: [managerId], references: [id])
  employees      Employee[]    @relation("DeptEmployees")
  positions      Position[]
  jobs           Job[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Position {
  id           String      @id @default(uuid())
  title        String
  code         String      @unique
  description  String?
  minSalary    Float       @default(0)
  maxSalary    Float       @default(0)
  skills       String?     // Comma separated
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  employees    Employee[]
  jobs         Job[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Employee {
  id               String           @id @default(uuid())
  employeeId       String           @unique
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  email            String           @unique
  phone            String?
  dateOfBirth      DateTime?
  gender           String           @default("PREFER_NOT_TO_SAY")
  address          String?
  profilePhoto     String?
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  departmentId     String?
  department       Department?      @relation("DeptEmployees", fields: [departmentId], references: [id])
  positionId       String?
  position         Position?        @relation(fields: [positionId], references: [id])
  managerId        String?
  manager          Employee?        @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates     Employee[]       @relation("ManagerSubordinates")
  managedDepts     Department[]     @relation("DeptManager")
  
  employmentType   String           @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN, TEMPORARY
  employmentStatus String           @default("ACTIVE")    // ACTIVE, ON_LEAVE, SUSPENDED, TERMINATED, RESIGNED
  hireDate         DateTime         @default(now())
  basicSalary      Float            @default(0)
  bankName         String?
  accountNumber    String?
  branchCode       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelationship String?

  attendances      Attendance[]
  workReports      WorkReport[]
  leaveRequests    LeaveRequest[]   @relation("EmployeeLeaveRequests")
  approvedLeaves   LeaveRequest[]   @relation("ApproverLeaveRequests")
  leaveBalances    LeaveBalance[]
  payslips         Payslip[]
  givenReviews     PerformanceReview[] @relation("Reviewer")
  receivedReviews  PerformanceReview[] @relation("Reviewee")
  goals            Goal[]
  documents        Document[]
  assignedJobs     Job[]            @relation("JobRecruiter")
  conductedInterviews Interview[]  @relation("Interviewer")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([employeeId])
  @@index([departmentId])
  @@index([employmentStatus])
}

model Job {
  id             String          @id @default(uuid())
  title          String
  code           String          @unique
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  positionId     String?
  position       Position?       @relation(fields: [positionId], references: [id])
  location       String          @default("Remote")
  employmentType String          @default("FULL_TIME")
  minSalary      Float?
  maxSalary      Float?
  description    String
  requirements   String
  responsibilities String?
  recruiterId    String?
  recruiter      Employee?       @relation("JobRecruiter", fields: [recruiterId], references: [id])
  closingDate    DateTime?
  status         String          @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED, ARCHIVED
  candidates     Candidate[]
  interviews     Interview[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Candidate {
  id             String          @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  resumeUrl      String?
  coverLetter    String?
  jobId          String
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage          String          @default("APPLIED") // APPLIED, SCREENING, SHORTLISTED, INTERVIEW, ASSESSMENT, OFFER, HIRED, REJECTED
  rating         Int             @default(0)
  notes          String?
  interviews     Interview[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([jobId])
  @@index([stage])
}

model Interview {
  id            String          @id @default(uuid())
  candidateId   String
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job             @relation(fields: [jobId], references: [id])
  interviewerId String?
  interviewer   Employee?       @relation("Interviewer", fields: [interviewerId], references: [id])
  scheduledAt   DateTime
  location      String?         
  status        String          @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, RESCHEDULED
  feedback      String?
  rating        Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  totalHours  Float            @default(0)
  status      String           @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY, ON_LEAVE
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model WorkReport {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime
  summary        String
  tasks          String?
  blockers       String?
  hoursWorked    Float     @default(0)
  attachmentUrl  String?
  status         String    @default("SUBMITTED") // DRAFT, SUBMITTED, REVIEWED, APPROVED, REJECTED
  managerNotes   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
}

model LeaveType {
  id            String         @id @default(uuid())
  name          String         @unique 
  code          String         @unique
  maxDays       Int            @default(20)
  isPaid        Boolean        @default(true)
  description   String?
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model LeaveRequest {
  id           String      @id @default(uuid())
  employeeId   String
  employee     Employee    @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  totalDays    Float
  reason       String
  documentUrl  String?
  status       String      @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approverId   String?
  approver     Employee?   @relation("ApproverLeaveRequests", fields: [approverId], references: [id])
  rejectionReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  allocated   Float     @default(20)
  used        Float     @default(0)
  pending     Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model Payroll {
  id          String        @id @default(uuid())
  title       String        
  month       Int
  year        Int
  totalAmount Float         @default(0)
  status      String        @default("DRAFT") // DRAFT, PROCESSING, COMPLETED
  processedAt DateTime?
  payslips    Payslip[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([month, year])
}

model Payslip {
  id            String        @id @default(uuid())
  payrollId     String
  payroll       Payroll       @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payPeriod     String
  basicSalary   Float
  allowances    Float         @default(0)
  overtimePay   Float         @default(0)
  bonuses       Float         @default(0)
  deductions    Float         @default(0)
  taxDeduction  Float         @default(0)
  netSalary     Float
  status        String        @default("UNPAID") // UNPAID, PAID
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId])
  @@index([payrollId])
}

model PerformanceReview {
  id             String    @id @default(uuid())
  reviewerId     String
  reviewer       Employee  @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId     String
  reviewee       Employee  @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewPeriod   String    
  qualityOfWork  Int       @default(3)
  productivity   Int       @default(3)
  teamwork       Int       @default(3)
  communication  Int       @default(3)
  attendanceRating Int     @default(3)
  problemSolving Int       @default(3)
  leadership     Int       @default(3)
  professionalism Int      @default(3)
  overallScore   Float     @default(3.0)
  feedback       String?
  goalsForNextPeriod String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([revieweeId])
}

model Goal {
  id          String     @id @default(uuid())
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime
  dueDate     DateTime
  priority    String     @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  progress    Int        @default(0) 
  status      String     @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([employeeId])
}

model Document {
  id           String       @id @default(uuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title        String
  documentType String       @default("OTHER") // ID_DOCUMENT, CONTRACT, CERTIFICATE, QUALIFICATION, TAX_DOCUMENT, MEDICAL, OTHER
  fileUrl      String
  fileSize     String?
  mimeType     String?
  uploadedAt   DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([employeeId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   
  resource    String   
  resourceId  String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
}
